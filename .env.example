# Local development only: the database from docker-compose.yml. Production values live on Vercel and in
# the `production` GitHub environment, never in this repository.
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban
API_URL=http://localhost:4000
# Better Auth. BETTER_AUTH_URL is the web origin. In production both are required (random secret, 32+ chars).
# Without them, local development falls back to http://localhost:3000 and a fixed development secret.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
