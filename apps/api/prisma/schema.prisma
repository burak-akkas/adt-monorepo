generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Small key-value settings. It also proves the path from migration to deployed code.
model AppSetting {
  key   String @id
  value String
}

// The four tables below belong to Better Auth (accounts and sessions). Don't rename their columns.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  boards        Board[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Priority {
  low
  medium
  high
}

enum CoverColor {
  red
  orange
  yellow
  green
  teal
  blue
  purple
  pink
}

// Boards, lists and cards. `position` is a dense 0..n-1 integer within the parent, always read in order.
// Case-insensitive unique names (board per user, list per board) are raw-SQL indexes in the add_boards
// migration (`board_userId_lower_name_key`, `board_list_boardId_lower_name_key`); Prisma can't express them.
model Board {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  lists     BoardList[]

  backgroundColor    String?
  backgroundImageUrl String?
  view               BoardView         @default(board)
  // The lists chosen for insights. Deleting a list clears the choice.
  doingListId        String?
  doingList          BoardList?        @relation("BoardDoingList", fields: [doingListId], references: [id], onDelete: SetNull)
  doneListId         String?
  doneList           BoardList?        @relation("BoardDoneList", fields: [doneListId], references: [id], onDelete: SetNull)
  formerLists        BoardFormerList[]
  templates          CardTemplate[]

  @@index([userId])
  @@map("board")
}

model BoardList {
  id        String   @id @default(uuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  cards     Card[]
  // 1..99, null = no limit
  wipLimit  Int?
  collapsed Boolean  @default(false)
  doingOf   Board[]  @relation("BoardDoingList")
  doneOf    Board[]  @relation("BoardDoneList")

  @@index([boardId, position])
  @@map("board_list")
}

enum BoardView {
  board
  calendar
  table
}

// The last name of a deleted list, so activity entries that mention it stay readable.
// No FK on listId: the list is gone by design.
model BoardFormerList {
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  listId  String
  name    String

  @@id([boardId, listId])
  @@map("board_former_list")
}

// Case-insensitive unique name per board is a raw-SQL index in the add_card_templates migration
// (`card_template_boardId_lower_name_key`); Prisma can't express it. Labels and checklist are texts only.
model CardTemplate {
  id        String      @id @default(uuid())
  boardId   String
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  title     String
  priority  Priority    @default(medium)
  notes     String?
  labels    String[]
  cover     CoverColor?
  checklist String[]
  createdAt DateTime    @default(now())

  @@index([boardId, createdAt])
  @@map("card_template")
}

model Card {
  id        String      @id @default(uuid())
  listId    String
  list      BoardList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  title     String
  priority  Priority    @default(medium)
  cover     CoverColor?
  dueDate   DateTime?   @db.Date
  notes     String?
  position  Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  checklist ChecklistItem[]
  comments  CardComment[]
  labels    CardLabel[]
  activity  CardActivity[]

  @@index([listId, position])
  @@map("card")
}

// Card details. All cascade when the card is deleted.
model ChecklistItem {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now())

  @@index([cardId, position])
  @@map("checklist_item")
}

model CardComment {
  id        String    @id @default(uuid())
  cardId    String
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([cardId, createdAt])
  @@map("card_comment")
}

// Case-insensitive unique label per card is a raw-SQL index in the add_card_details migration
// (`card_label_cardId_lower_name_key`); Prisma can't express it.
model CardLabel {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name      String
  position  Int
  createdAt DateTime @default(now())

  @@index([cardId, position])
  @@map("card_label")
}

// `type` is validated by the contract enum. `from`/`to` are list ids for `moved`, old/new values otherwise.
model CardActivity {
  id     String   @id @default(uuid())
  cardId String
  card   Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type   String
  at     DateTime @default(now())
  from   String?
  to     String?

  @@index([cardId, at])
  @@map("card_activity")
}
